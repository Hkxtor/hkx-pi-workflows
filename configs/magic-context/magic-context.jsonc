{
  "enabled": true,
  "auto_update": true,
  "language": "zh",
  "cache_ttl": "5m",
  "execute_threshold_percentage": 65,
  "execute_threshold_tokens": {
    "default": 200000
  },
  "history_budget_percentage": 0.18,
  "compaction": {
    "enabled": true
  },
  "smart_drops": false,
  "caveman_text_compression": {
    "enabled": false
  },
  "dreamer": {
    "disable": true
  },
  "historian": {
    "pi": {
      "model": {
        "model": "meme/deepseek-v4-flash",
        "thinking_level": "medium"
      },
      "fallback_models": [
        {
          "model": "pai/DeepSeek-V4.1-Flash"
        }
      ]
    }
  },
  "memory": {
    "enabled": false
  },
  "todowrite": {
    "enabled": false
  },
  "embedding": {
    "provider": "off"
  }
}
