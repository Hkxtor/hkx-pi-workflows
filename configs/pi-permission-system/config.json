{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.pi/agent/auth.json*": "deny",
      "~/.pi/agent/models.json*": "deny",
      "~/.pi/agent/mcp.json*": "deny",
      "~/.pi/profiles/*/agent/mcp.json*": "deny",
      "**/.pi/mcp.json*": "deny",
      "~/.codex/auth.json*": "deny"
    },
    "bash": {
      "*": "allow",
      "mv *": "ask",
      "git restore *": "ask",
      "Remove-Item *": "ask",
      "Move-Item *": "ask",
      "Rename-Item *": "ask",
      "Clear-Content *": "ask",
      "Set-Content *": "ask",
      "Out-File *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "rmdir *": "ask",
      "ri *": "ask",
      "powershell*Remove-Item*": "ask",
      "pwsh*Remove-Item*": "ask",
      "powershell*Move-Item*": "ask",
      "pwsh*Move-Item*": "ask",
      "powershell*Rename-Item*": "ask",
      "pwsh*Rename-Item*": "ask",
      "powershell*Clear-Content*": "ask",
      "pwsh*Clear-Content*": "ask",
      "powershell*Set-Content*": "ask",
      "pwsh*Set-Content*": "ask",
      "powershell*Out-File*": "ask",
      "pwsh*Out-File*": "ask",
      "cmd*del *": "ask",
      "cmd*erase *": "ask",
      "cmd*rd *": "ask",
      "cmd*rmdir *": "ask"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/var/tmp": "allow",
      "/var/tmp/*": "allow",
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      "~/.npm": "allow",
      "~/.npm/*": "allow",
      "~/.cargo/registry": "allow",
      "~/.cargo/registry/*": "allow",
      "~/development/*": "allow",
      "~/AppData/Local/Temp": "allow",
      "~/AppData/Local/Temp/*": "allow",
      "~/AppData/Local/npm-cache": "allow",
      "~/AppData/Local/npm-cache/*": "allow",
      "~/AppData/Roaming/npm/node_modules": "allow",
      "~/AppData/Roaming/npm/node_modules/*": "allow"
    }
  }
}
