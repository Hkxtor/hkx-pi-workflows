{
  "mcpServers": {
    "shrimp-task-manager": {
      "command": "npx",
      "args": ["-y", "mcp-shrimp-task-manager"],
      "exposure": "direct",
      "env": {
        "DATA_DIR": "${MCP_DATA_DIR}",
        "ENABLE_GUI": "false",
        "TEMPLATES_USE": "en"
      },
      "requiresEnv": ["MCP_DATA_DIR"],
      "description": "Persistent task planning and execution tracking via MCP Shrimp Task Manager."
    }
  }
}
